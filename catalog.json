{
  "plugins": [
    {
      "manifest": {
        "plugin_id": "silo.livetv",
        "version": "0.1.4",
        "checksum": "26baf0d2b3316f9f6792ec18d5da3de4e14672b40dcfafecee1f004b5766344a",
        "silo_api_version": "v1",
        "category": "Video/LiveTV",
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          }
        ],
        "capabilities": [
          {
            "type": "http_routes.v1",
            "id": "portal",
            "display_name": "Live TV",
            "description": "IPTV / M3U live TV portal with XMLTV EPG."
          },
          {
            "type": "scheduled_task.v1",
            "id": "refresh_m3u_sources",
            "display_name": "Refresh M3U sources",
            "cron": "0 */6 * * *",
            "description": "Re-downloads configured M3U playlists on schedule and refreshes the channel table."
          },
          {
            "type": "scheduled_task.v1",
            "id": "refresh_xmltv_sources",
            "display_name": "Refresh XMLTV sources",
            "cron": "0 */3 * * *",
            "description": "Re-downloads configured XMLTV EPG feeds on schedule and refreshes program data."
          },
          {
            "type": "scheduled_task.v1",
            "id": "reap_idle_sessions",
            "display_name": "Reap idle stream sessions",
            "cron": "* * * * *",
            "description": "Closes live-TV stream sessions whose clients have stopped pulling segments."
          }
        ],
        "http_routes": [
          {
            "id": "healthz",
            "method": "GET",
            "path": "/healthz",
            "access": "public"
          },
          {
            "id": "stream_bytes",
            "method": "GET",
            "path": "/api/v1/livetv/stream/*",
            "access": "public"
          },
          {
            "id": "admin_api",
            "method": "*",
            "path": "/api/v1/livetv/admin/*",
            "access": "admin"
          },
          {
            "id": "api",
            "method": "*",
            "path": "/api/v1/livetv/*",
            "access": "authenticated"
          }
        ],
        "global_config_schema": [
          {
            "key": "database_url",
            "title": "Postgres connection string",
            "description": "DSN for the dedicated livetv schema (e.g. postgres://plugin_livetv:...@host:5432/silo?search_path=livetv&sslmode=disable).",
            "json_schema": "{\"type\":\"object\",\"properties\":{\"value\":{\"type\":\"string\"}},\"required\":[\"value\"]}",
            "required": true,
            "admin_form": {
              "fields": [
                {
                  "key": "value",
                  "label": "Connection URL",
                  "control": "ADMIN_FORM_CONTROL_PASSWORD",
                  "required": true,
                  "secret": true
                }
              ]
            }
          }
        ]
      },
      "binaries": {
        "linux/amd64": {
          "url": "https://github.com/Tw1zT3d2four7/silo-plugin-livetv/releases/download/plugin-latest/silo-plugin-livetv",
          "checksum": "26baf0d2b3316f9f6792ec18d5da3de4e14672b40dcfafecee1f004b5766344a"
        }
      }
    }
  ]
}
